# Salin otomatis: make env-sync
# File .env tidak di-commit (berisi secret lokal).

# Path ke webhook targets (disarankan untuk development lokal)
WEBHOOK_TARGETS_FILE=deploy/targets.json

# Alternatif: inline JSON (override file jika diset)
# WEBHOOK_TARGETS=[{"Name":"Test","URL":"https://discord.com/api/webhooks/..."}]

# Untuk make secret-push (sync ke GitHub Actions)
GITHUB_REPO=adamnasrudin03/pray-notify
